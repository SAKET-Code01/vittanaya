# Vittanaya Environment Configuration Template
# SIH26091 — AI-Driven Hyper-Local Business Advisory and Financial Structuring Assistant
# Copy this file to .env for local development. Never commit real credentials to Git!

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Application Settings
APP_NAME=VITTANAYA
APP_VERSION=0.1.0

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Database Configuration (SQLite initially)
DATABASE_URL=sqlite:///./vittanaya.db

# Security & Tokens
SECRET_KEY=dev-insecure-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend (Vite) Configuration — set in frontend/.env.local for local dev,
# and in the Vercel project's Environment Variables for production.
# Public Google OAuth Client ID (Web application type) from Google Cloud Console.
# Client IDs are public values — never put a client secret here.
# Required for "Continue with Google" on http://localhost:3001 and https://vittanaya.vercel.app
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

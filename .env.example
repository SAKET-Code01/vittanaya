# Vittanaya Environment Configuration Template
# SIH26091 — AI-Driven Hyper-Local Business Advisory and Financial Structuring Assistant
# Copy this file to .env for local development. Never commit real credentials to Git!

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Application Settings
APP_NAME=VITTANAYA
APP_VERSION=0.1.0

# Database Configuration (Supabase PostgreSQL in production, local PostgreSQL or SQLite fallback in dev)
# Format for PostgreSQL: postgresql+psycopg://username:password@host:port/database
# Direct Supabase or Render Connection URL:
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/vittanaya

# External AI Provider (Groq Cloud API — Model: openai/gpt-oss-120b)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Security & Tokens
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration (comma-separated origins: local dev + deployed frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
